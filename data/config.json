{
  "version": "1.0",
  "ai": {
    "provider": "anthropic",
    "model": "claude-4-6-sonnet",
    "api_key_env": "ANTHROPIC_API_KEY",
    "languages": [
      "zh",
      "en"
    ]
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 24,
    "scoring_prompt": "你是一个专业的商业投资与创业顾问。请审查以下新闻，并针对我的兴趣给出0-10的评分。请重点关注并给予高分（7分以上）：1. 结合 AI 技术的变现思路、SaaS 产品发布、独立开发者盈利案例、搞钱副业。 2. 重要的全球金融市场新闻、宏观经济动向、美股/A股异动、财报发布。 对于纯技术代码探讨、日常闲聊或无关的科技八卦，请给予低分（4分以下）。"
  },
  "notifications": {
    "telegram": {
      "enabled": true,
      "bot_token_env": "TELEGRAM_BOT_TOKEN",
      "chat_id": "473268206"
    }
  },
  "sources": {
    "rss": [
      {
        "name": "FT中文网 (高质量金融/宏观)",
        "url": "http://www.ftchinese.com/rss/feed",
        "enabled": true
      },
      {
        "name": "Yahoo Finance (美股/全球金融前沿)",
        "url": "https://finance.yahoo.com/news/rss",
        "enabled": true
      },
      {
        "name": "Product Hunt (全球最新 AI 产品/商业化灵感)",
        "url": "https://www.producthunt.com/feed",
        "enabled": true
      },
      {
        "name": "Starter Story (海外独立开发者/创业者真实盈利案例)",
        "url": "https://www.starterstory.com/rss.xml",
        "enabled": true
      },
      {
        "name": "Indie Hackers (全球最大独立开发者搞钱社区)",
        "url": "https://www.indiehackers.com/rss",
        "enabled": true
      },
      {
        "name": "V2EX 创投 (国内搞钱与副业)",
        "url": "https://www.v2ex.com/feed/create.xml",
        "enabled": true
      },
      {
        "name": "Reddit SaaS (海外软件变现 - 代理源)",
        "url": "https://rsshub.app/reddit/subreddit/SaaS",
        "enabled": true
      },
      {
        "name": "Reddit SideProject (海外副业 - 代理源)",
        "url": "https://rsshub.app/reddit/subreddit/SideProject",
        "enabled": true
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "SaaS",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15
        },
        {
          "subreddit": "SideProject",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15
        },
        {
          "subreddit": "investing",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15
        }
      ]
    },
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50
    }
  }
}
