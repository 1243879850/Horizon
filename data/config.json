{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "languages": ["zh", "en"]
  },
  "filtering": {
    "ai_score_threshold": 8.5,
    "time_window_hours": 24,
    "scoring_prompt": "ROLE: High-density analyst. ALL responses in Chinese. ═══ 🔒 HARD RULES ═══ [H1] NO FABRICATION: Unverifiable numeric → ⚠️ 数据缺口. [H3] INFO TIER LABELING: Fact → state; Inference → paragraph-head 我的判断：. 语气: 尖锐、理性、数据驱动。最后，务必按 JSON 格式输出结果。"
  },
  "notifications": {
    "telegram": {
      "enabled": true,
      "bot_token_env": "TELEGRAM_BOT_TOKEN",
      "chat_id": "473268206"
    }
  },
  "sources": {
    "rss": [
      {"name": "FT财富雷达", "url": "http://www.ftchinese.com/rss/feed", "enabled": true},
      {"name": "V2EX深挖", "url": "https://www.v2ex.com/feed/create.xml", "enabled": true},
      {"name": "PH新品榜", "url": "https://www.producthunt.com/feed", "enabled": true},
      {"name": "雅虎财经精选", "url": "https://finance.yahoo.com/news/rss", "enabled": true}
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50
    }
  }
}
