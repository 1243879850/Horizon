      { "name": "Google AI-动态", "url": "https://blog.google/technology/ai/rss/", "enabled": true },
      
      { "name": "36Kr-深度资讯", "url": "https://36kr.com/feed", "enabled": true },
      { "name": "IT之家-科技动态", "url": "https://www.ithome.com/rss/", "enabled": true },
      { "name": "财新网-经济", "url": "https://www.caixin.com/rss/index.xml", "enabled": true }
