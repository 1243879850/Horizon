      { "name": "The Economist-世界", "url": "https://www.economist.com/the-world-this-week/rss.xml", "enabled": true },
      
      { "name": "Product Hunt-新品", "url": "https://www.producthunt.com/feed", "enabled": true },
      { "name": "V2EX-创投深挖", "url": "https://www.v2ex.com/feed/create.xml", "enabled": true },
      { "name": "Indie Hackers-出海", "url": "https://www.indiehackers.com/rss", "enabled": true },
      { "name": "Hacker News-每日精选", "url": "https://feeds.feedburner.com/hackernews/best", "enabled": true },
      
      { "name": "TechCrunch-初创", "url": "https://techcrunch.com/feed/", "enabled": true },
      { "name": "Wired-前沿技术", "url": "https://www.wired.com/feed/rss", "enabled": true },
      { "name": "The Verge-消费电子", "url": "https://www.theverge.com/rss/index.xml", "enabled": true },
