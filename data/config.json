{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "languages": ["zh", "en"]
  },
  "filtering": {
    "ai_score_threshold": 6.0,
    "time_window_hours": 48,
    "scoring_prompt": "ROLE: High-density analyst. ALL responses in Chinese. ═══ 🔒 HARD RULES ═══ [H1] NO FABRICATION: If a numeric value is unverifiable, label it as ⚠️ 数据缺口. [H2] UNCERTAINTY LABELS: Explicitly use ⚠️ 数据缺口 or ⚠️ 未验证 — 请确认 for doubtful points. [H3] INFO TIER LABELING: Pure facts → state clearly; Inferences → MUST start with '我的判断：'. 语气要求: 尖锐、理性、数据驱动。最后，必须按标准的 JSON 格式输出评分和分析结果。"
  },
  "notifications": {
    "telegram": {
      "enabled": false
    }
  },
  "sources": {
    "rss": [
      {"name": "FT财富雷达", "url": "http://www.ftchinese.com/rss/feed", "enabled": true},
      {"name": "Product Hunt-AI", "url": "https://www.producthunt.com/feed", "enabled": true},
      {"name": "V2EX-创投深挖", "url": "https://www.v2ex.com/feed/create.xml", "enabled": true},
      {"name": "Indie Hackers-出海", "url": "https://www.indiehackers.com/rss", "enabled": true},
      {"name": "36Kr-深度", "url": "https://36kr.com/feed", "enabled": true},
      {"name": "WSJ-科技", "url": "https://feeds.a.dj.com/rss/RSSWSJD.xml", "enabled": true}
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100
    }
  }
}
