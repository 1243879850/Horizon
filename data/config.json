{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "languages": ["zh", "en"]
  },
  "filtering": {
    "ai_score_threshold": 8.8, 
    "time_window_hours": 24,
    "scoring_prompt": "ROLE: High-density analyst. ALL Chinese. RULES: [H1] NO FABRICATION. [H2] UNCERTAINTY LABELS. [H3] INFO TIER: Fact -> state; Inference -> 我的判断：. 语气: 尖锐、理性、数据驱动。最后，必须按 JSON 格式输出。"
  },
  "notifications": {
    "telegram": {
      "enabled": true,
      "bot_token_env": "TELEGRAM_BOT_TOKEN",
      "chat_id": 473268206
    }
  },
  "sources": {
    "rss": [
      {"name": "FT中文网", "url": "http://www.ftchinese.com/rss/feed", "enabled": true},
      {"name": "V2EX 创投", "url": "https://www.v2ex.com/feed/create.xml", "enabled": true},
      {"name": "Product Hunt", "url": "https://www.producthunt.com/feed", "enabled": true},
      {"name": "Yahoo Finance", "url": "https://finance.yahoo.com/news/rss", "enabled": true},
      {"name": "Indie Hackers", "url": "https://www.indiehackers.com/rss", "enabled": true}
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 50
    }
  }
}
